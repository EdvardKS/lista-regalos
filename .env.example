# Copia este archivo a .env y rellénalo. El .env real NO se sube al repositorio.

# Administradores: móvil:correo, separados por comas. Entran con móvil + PIN enviado a ese correo.
ADMINS=600000001:admin1@example.com,600000002:admin2@example.com

# Dirección pública de la web (sin barra final). Se usa en la tarjeta de vista previa y en los correos.
PUBLIC_ORIGIN=https://listas.example.com

# Correo saliente: relay SMTP sin autenticación, accesible desde el contenedor.
SMTP_HOST=smtp
SMTP_PORT=25
MAIL_FROM=noreply@example.com

# Contacto que aparece en la política de privacidad.
PRIVACY_CONTACT=contacto@example.com

# Opcional: buzones a los que nunca se debe enviar correo, separados por comas.
BLOCKED_RECIPIENTS=
